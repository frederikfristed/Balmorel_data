*Equation to ensure that in those areas where there is written no potential, there is no consumption of resource                                                                                                                                                                      
SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP')$(AAAOPTIFLOW(AAA) AND (NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_UP')) AND SUM(IAE,SOSIBUBOUND(Y,IAE,PROC,FLOW,'ILOUPFX_UP')))=EPS;                                                                                                          
SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_FX')$(AAAOPTIFLOW(AAA) AND (NOT SOSIBUBOUND(Y,AAA,PROC,FLOW,'ILOUPFX_FX')) AND SUM(IAE,SOSIBUBOUND(Y,IAE,PROC,FLOW,'ILOUPFX_FX')))=EPS;                                                                                                          
                                                                                                                                                                                                                                                                                      
***Generalise transport demand                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                      
*Aviation                                                                                                                                                                                                                                                                             
SOSIBUBOUND('2030',AAA,'Aviation_Buffer','AVIATION_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Aviation_Buffer','AVIATION_FLOW',iLOUPFXSET)*0.1;                                                                                                                                      
SOSIBUBOUND('2040',AAA,'Aviation_Buffer','AVIATION_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Aviation_Buffer','AVIATION_FLOW',iLOUPFXSET)*1;                                                                                                                                        
                                                                                                                                                                                                                                                                                      
*Road                                                                                                                                                                                                                                                                                 
SOSIBUBOUND('2030',AAA,'Road_Buffer','ROAD_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Road_Buffer','ROAD_FLOW',iLOUPFXSET)*0.1;                                                                                                                                                      
SOSIBUBOUND('2040',AAA,'Road_Buffer','ROAD_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Road_Buffer','ROAD_FLOW',iLOUPFXSET)*1;                                                                                                                                                        
                                                                                                                                                                                                                                                                                      
*Shipping                                                                                                                                                                                                                                                                             
SOSIBUBOUND('2030',AAA,'Shipping_Buffer','SHIPPING_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Shipping_Buffer','SHIPPING_FLOW',iLOUPFXSET)*0.1;                                                                                                                                      
SOSIBUBOUND('2040',AAA,'Shipping_Buffer','SHIPPING_FLOW',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Shipping_Buffer','SHIPPING_FLOW',iLOUPFXSET)*1;                                                                                                                                        
                                                                                                                                                                                                                                                                                      
***Biogas                                                                                                                                                                                                                                                                             
SOSIBUBOUND('2030',AAA,'Manure_Source','BIOMASS_FLOW_MANURE',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Manure_Source','BIOMASS_FLOW_MANURE',iLOUPFXSET);                                                                                                                                  
SOSIBUBOUND('2040',AAA,'Manure_Source','BIOMASS_FLOW_MANURE',iLOUPFXSET) = SOSIBUBOUND('2050',AAA,'Manure_Source','BIOMASS_FLOW_MANURE',iLOUPFXSET);                                                                                                                                  
                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                      

*Generalise to all areas                                                                                                                                                                                                                                                               
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROCTO,FLOW)$AAAOPTIFLOW(AAA)=FLOWFROMTOPROC_A('DK011_A',IPROCFROM,IPROCTO,FLOW);                                                                                                                                                                      
                                                                                                                                                                                                                                                                                       
*No fossil CO2 for CU after 2040                                                                                                                                                                                                                                                       
FLOWFROMTOPROC(Y,AAA,'CO2_Grid','CO2_CU','CO2_FLOW_FOSSIL')$(YVALUE(Y) GE 2040) = 0;                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                       
*Offshore constraints                                                                                                                                                                                                                                                                  
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROCTO,FLOW)$AAAOPTIFLOW_Offshore(AAA) = 0;                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                       
*CO2 supply to offshore areas                                                                                                                                                                                                                                                          
FLOWFROMTOPROC(Y,AAA,'Transport_Pipeline_CO2','CO2_Grid','CO2_FLOW_FOSSIL')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                             
FLOWFROMTOPROC(Y,AAA,'Transport_Pipeline_CO2','CO2_Grid','CO2_FLOW_BIO')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                
FLOWFROMTOPROC(Y,AAA,'Transport_Pipeline_CO2','CO2_Grid','CO2_FLOW')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                    
FLOWFROMTOPROC(Y,AAA,'Transport_Truck_CO2','CO2_Grid','CO2_FLOW_FOSSIL')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                
FLOWFROMTOPROC(Y,AAA,'Transport_Truck_CO2','CO2_Grid','CO2_FLOW_BIO')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                   
FLOWFROMTOPROC(Y,AAA,'Transport_Truck_CO2','CO2_Grid','CO2_FLOW')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                       
FLOWFROMTOPROC(Y,AAA,'Transport_Ship_CO2','CO2_Grid','CO2_FLOW_FOSSIL')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                 
FLOWFROMTOPROC(Y,AAA,'Transport_Ship_CO2','CO2_Grid','CO2_FLOW_BIO')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                    
FLOWFROMTOPROC(Y,AAA,'Transport_Ship_CO2','CO2_Grid','CO2_FLOW')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                       
*CO2 sequestration in offshore areas                                                                                                                                                                                                                                                   
FLOWFROMTOPROC(Y,AAA,'CO2_Grid','CO2_Seq','CO2_FLOW_FOSSIL')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                            
FLOWFROMTOPROC(Y,AAA,'CO2_Grid','CO2_Seq','CO2_FLOW_BIO')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                               
FLOWFROMTOPROC(Y,AAA,'CO2_Grid','CO2_Seq','CO2_FLOW')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                                   
FLOWFROMTOPROC(Y,AAA,'CO2_Seq','Seq_Off_Y','CO2_FLOW')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                                  
FLOWFROMTOPROC(Y,AAA,'Seq_Off_Y','CO2_Seq_Sum','CO2_FLOW')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                              
FLOWFROMTOPROC(Y,AAA,'CO2_Seq_Sum','CO2_Seq_Buffer','CO2_FLOW')$AAAOPTIFLOW_Offshore(AAA) = 1;                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                       
*Onshore constraints                                                                                                                                                                                                                                                                   
FLOWFROMTOPROC(Y,AAA,'CO2_Seq','Seq_Off_Y','CO2_FLOW')$AAAOPTIFLOW_Onshore(AAA) = 0;                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                       
*Generalise to all technologies defined by investment year                                                                                                                                                                                                                             
FLOWFROMTOPROC(Y,AAA,IPROC2,IPROCTO,FLOW) =                                                                                                                                                                                                                                            
FLOWFROMTOPROC(Y,AAA,IPROC2,IPROCTO,FLOW)                                                                                                                                                                                                                                              
+ SUM((IPROCFROM,TECH_GROUP)$(                                                                                                                                                                                                                                                         
    TECH_GROUP_AS_PROC(IPROCFROM)                                                                                                                                                                                                                                                      
 AND SAMEAS(IPROCFROM,TECH_GROUP)                                                                                                                                                                                                                                                      
 AND PROCTECHTYPE(IPROC2,TECH_GROUP)                                                                                                                                                                                                                                                   
),                                                                                                                                                                                                                                                                                     
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROCTO,FLOW));                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                       
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROC2,FLOW) =                                                                                                                                                                                                                                          
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROC2,FLOW)                                                                                                                                                                                                                                            
+ SUM((IPROCTO,TECH_GROUP)$(                                                                                                                                                                                                                                                           
    TECH_GROUP_AS_PROC(IPROCTO)                                                                                                                                                                                                                                                        
 AND SAMEAS(IPROCTO,TECH_GROUP)                                                                                                                                                                                                                                                        
 AND PROCTECHTYPE(IPROC2,TECH_GROUP)                                                                                                                                                                                                                                                   
),                                                                                                                                                                                                                                                                                     
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROCTO,FLOW));                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                       
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROCTO,FLOW)$(TECH_GROUP_AS_PROC(IPROCFROM)) = 0;                                                                                                                                                                                                      
FLOWFROMTOPROC(Y,AAA,IPROCFROM,IPROCTO,FLOW)$(TECH_GROUP_AS_PROC(IPROCTO))   = 0;                                                                                                                                                                                                      
